    {
      "id": "email-partner-qbr-summary",
      "name": "Email Partner - QBR Summary & Action Items",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1250,
        700
      ],
      "parameters": {
        "fromEmail": "channel@yourcompany.com",
        "toEmail": "={{ $json.partnerEmail }}",
        "subject": "={{ 'Your ' + $json.quarter + ' QBR Summary \u2014 Action Items Inside' }}",
        "text": "={{ 'Hi ' + $json.partnerName + ' team,\\n\\nThank you for completing your ' + $json.quarter + ' QBR. Here is your summary:\\n\\n--- QBR OUTCOMES ---\\n\\nQBR Score: ' + $json.qbrScore + '/100 \u2014 ' + $json.performanceLabel + '\\nStatus: ' + $json.qbrStatus + '\\n\\nNEXT QUARTER TARGETS\\nRevenue Target: $' + $json.nextQuarterRevenueTarget.toLocaleString() + '\\nDeals Target: ' + $json.nextQuarterDealsTarget + '\\n\\nACTION ITEMS\\n' + $json.actionItems + '\\n\\nGOALS FOR ' + ($json.quarter.includes('Q1') ? 'Q2' : $json.quarter.includes('Q2') ? 'Q3' : $json.quarter.includes('Q3') ? 'Q4' : 'Q1') + '\\n' + $json.nextQuarterGoals + '\\n\\nYour channel manager (' + $json.channelManager + ') will follow up to track progress.\\n\\nBest,\\nChannel Team' }}",
        "options": {}
      }
    },
    {
