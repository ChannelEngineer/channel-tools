      }
    },
    {
      "id": "pipeline-health-connector",
      "name": "Pipeline Health Connector",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [850, 400],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "totalPipelineValue",
              "value": "={{ $json.body.totalPipelineValue || $json.totalPipelineValue || 2500000 }}"
            },
            {
              "name": "registeredDealCount",
              "value": "={{ $json.body.registeredDealCount || $json.registeredDealCount || 45 }}"
            },
            {
              "name": "highConfidenceDeals",
              "value": "={{ $json.body.highConfidenceDeals || $json.highConfidenceDeals || 18 }}"
            },
            {
              "name": "mediumConfidenceDeals",
              "value": "={{ $json.body.mediumConfidenceDeals || $json.mediumConfidenceDeals || 20 }}"
            },
            {
              "name": "lowConfidenceDeals",
              "value": "={{ $json.body.lowConfidenceDeals || $json.lowConfidenceDeals || 7 }}"
            },
            {
              "name": "quarterlyTarget",
              "value": "={{ $json.body.quarterlyTarget || $json.quarterlyTarget || 5000000 }}"
            },
            {
              "name": "weightedPipeline",
              "value": "={{ ($json.highConfidenceDeals * 10000 * 0.75) + ($json.mediumConfidenceDeals * 10000 * 0.50) + ($json.lowConfidenceDeals * 10000 * 0.25) }}"
            }
          ],
          "string": [
            {
              "name": "pipelineHealth",
              "value": "={{ $json.weightedPipeline >= $json.quarterlyTarget * 3 ? 'Excellent' : $json.weightedPipeline >= $json.quarterlyTarget * 2 ? 'Good' : $json.weightedPipeline >= $json.quarterlyTarget * 1.5 ? 'Adequate' : $json.weightedPipeline >= $json.quarterlyTarget ? 'Below Target' : 'Critical' }}"
            },
            {
              "name": "highConfidenceRatio",
              "value": "={{ $json.registeredDealCount > 0 ? Math.round(($json.highConfidenceDeals / $json.registeredDealCount) * 100) + '%' : '0%' }}"
            },
            {
              "name": "coverageRatio",
              "value": "={{ $json.totalPipelineValue > 0 && $json.quarterlyTarget > 0 ? ($json.totalPipelineValue / $json.quarterlyTarget).toFixed(1) + 'x' : '0.0x' }}"
            }
          ]
        }
      }
    },
    {
      "id": "respond-pipeline-health",
      "name": "Respond - Pipeline Health",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 400],
      "parameters": {
        "respondWith": "json",
