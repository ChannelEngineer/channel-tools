{
  "name": "DISCERN — Partner Deal Intelligence, Scoring & Confidence-Enabled Routing Network",
  "nodes": [
    {
      "id": "webhook-discern-inbound",
      "name": "Webhook - DISCERN Inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "path": "discern-deal-intelligence",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "responseData": "firstInputJson"
      },
      "webhookId": "discern-deal-hook"
    },
    {
      "id": "format-discern-data",
      "name": "Format Deal Registration Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [450, 300],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "action",
              "value": "={{ $json.body.action || $json.action || 'score_deal' }}"
            },
            {
              "name": "partnerId",
              "value": "={{ $json.body.partnerId || $json.partnerId || '' }}"
            },
            {
              "name": "partnerName",
              "value": "={{ $json.body.partnerName || $json.partnerName || '' }}"
            },
            {
              "name": "partnerEmail",
              "value": "={{ $json.body.partnerEmail || $json.partnerEmail || '' }}"
            },
            {
              "name": "partnerTier",
              "value": "={{ ($json.body.partnerTier || $json.partnerTier || '').toString() }}"
            },
            {
              "name": "channelManagerEmail",
              "value": "={{ $json.body.channelManagerEmail || $json.channelManagerEmail || '' }}"
            },
            {
              "name": "channelManagerName",
              "value": "={{ $json.body.channelManagerName || $json.channelManagerName || '' }}"
            },
            {
              "name": "endCustomer",
              "value": "={{ $json.body.endCustomer || $json.endCustomer || '' }}"
            },
            {
              "name": "productCategory",
              "value": "={{ $json.body.productCategory || $json.productCategory || 'General' }}"
            },
            {
              "name": "dealDescription",
              "value": "={{ $json.body.dealDescription || $json.dealDescription || '' }}"
            },
            {
              "name": "competition",
              "value": "={{ $json.body.competition || $json.competition || 'Unknown' }}"
            },
            {
              "name": "salesCycleStage",
              "value": "={{ $json.body.salesCycleStage || $json.salesCycleStage || 'Discovery' }}"
            },
            {
              "name": "registrationId",
              "value": "={{ 'DR-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).substring(2,6).toUpperCase() }}"
            },
            {
              "name": "scoredAt",
              "value": "={{ new Date().toISOString() }}"
            }
          ],
          "number": [
            {
              "name": "dealValue",
              "value": "={{ $json.body.dealValue || $json.dealValue || 0 }}"
            },
            {
              "name": "historicalWinRate",
              "value": "={{ $json.body.historicalWinRate || $json.historicalWinRate || 0 }}"
            },
            {
              "name": "productExpertiseScore",
              "value": "={{ $json.body.productExpertiseScore || $json.productExpertiseScore || 0 }}"
            },
            {
              "name": "pipelineVelocity",
              "value": "={{ $json.body.pipelineVelocity || $json.pipelineVelocity || 0 }}"
            },
            {
              "name": "competitiveIntensity",
              "value": "={{ $json.body.competitiveIntensity || $json.competitiveIntensity || 5 }}"
            },
            {
              "name": "partnerEngagementScore",
              "value": "={{ $json.body.partnerEngagementScore || $json.partnerEngagementScore || 70 }}"
            }
          ]
        }
      }
    },
    {
      "id": "route-discern-action",
      "name": "Route by Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [650, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.action }}",
        "rules": [
          {
            "value2": "score_deal",
            "output": 0
          },
          {
            "value2": "pipeline_health",
            "output": 1
          }
        ],
        "fallbackOutput": 0
      }
    },
    {
      "id": "calculate-deal-score",
      "name": "Calculate Predictive Deal Score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [850, 100],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "tierScore",
              "value": "={{ $json.partnerTier === 'Platinum' ? 95 : $json.partnerTier === 'Gold' ? 80 : $json.partnerTier === 'Silver' ? 65 : 50 }}"
            },
            {
              "name": "winRateScore",
              "value": "={{ Math.min($json.historicalWinRate * 100, 100) }}"
            },
            {
              "name": "dealSizeScore",
              "value": "={{ $json.dealValue > 0 ? ($json.dealValue >= 100000 ? 90 : $json.dealValue >= 50000 ? 80 : $json.dealValue >= 25000 ? 70 : $json.dealValue >= 10000 ? 60 : 50) : 0 }}"
            },
            {
              "name": "expertiseScore",
              "value": "={{ $json.productExpertiseScore }}"
            },
            {
              "name": "velocityScore",
              "value": "={{ Math.min($json.pipelineVelocity * 100, 100) }}"
            },
            {
              "name": "competitionScore",
              "value": "={{ Math.max(100 - ($json.competitiveIntensity * 10), 10) }}"
            },
            {
              "name": "engagementScore",
              "value": "={{ $json.partnerEngagementScore }}"
            },
            {
              "name": "confidenceScore",
              "value": "={{ Math.round(($json.tierScore * 0.25) + ($json.winRateScore * 0.20) + ($json.dealSizeScore * 0.10) + ($json.expertiseScore * 0.15) + ($json.velocityScore * 0.10) + ($json.competitionScore * 0.10) + ($json.engagementScore * 0.10)) }}"
            }
          ],
          "string": [
            {
              "name": "confidenceLevel",
              "value": "={{ $json.confidenceScore >= 75 ? 'High' : $json.confidenceScore >= 50 ? 'Medium' : 'Low' }}"
            },
            {
              "name": "recommendedDiscount",
              "value": "={{ $json.confidenceScore >= 80 ? 'Standard (10%)' : $json.confidenceScore >= 65 ? 'Standard (10%) with 5% flex' : $json.confidenceScore >= 50 ? 'Standard (10%) — partner to justify discount' : 'No discount — partner needs to qualify further' }}"
            },
            {
              "name": "coachingTips",
              "value": "={{ $json.confidenceScore >= 75 ? 'Partner is well-positioned. Provide standard support and competitive analysis.' : $json.confidenceScore >= 50 ? 'Partner needs support. Consider: (1) Joint sales call with your SE, (2) ROI calculator for buyer, (3) Reference case study from similar deal.' : 'High-touch support needed: (1) Set up intro call between partner and your sales team, (2) Provide competitive battlecard, (3) Schedule internal pipeline review, (4) Consider discount authorization.' }}"
            },
            {
              "name": "riskFactors",
              "value": "={{ $json.competitionScore < 40 ? 'Strong competition detected — provide competitive positioning support|' : '' }}{{ $json.winRateScore < 40 ? 'Low historical win rate — partner may need coaching|' : '' }}{{ $json.expertiseScore < 40 ? 'Limited product expertise — consider joint demo or SE support|' : '' }}{{ $json.engagementScore < 40 ? 'Low partner engagement — recent activity is minimal|' : '' }}{{ $json.dealSizeScore < 40 ? 'Small deal value — verify partner capability|' : '' }}"
            }
          ]
        }
      }
    },
    {
      "id": "route-by-confidence",
      "name": "Route by Confidence Score",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 100],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.confidenceScore }}",
              "operation": "largerEqual",
              "value2": 75
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and"
        }
      }
    },
    {
      "id": "secondary-if-medium",
      "name": "Medium Confidence Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 0],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.confidenceScore }}",
              "operation": "largerEqual",
              "value2": 50
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and"
        }
      }
    },
    {
      "id": "slack-high-confidence",
      "name": "Slack - High Confidence Deal",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1450, -150],
      "parameters": {
        "authentication": "credential",
        "resource": "message",
        "channelId": "=C04DEALHIGH",
        "text": "=🟢 *High Confidence Deal Registration* — Score: {{ $json.confidenceScore }}/100\n*Partner:* {{ $json.partnerName }} ({{ $json.partnerTier }})\n*Customer:* {{ $json.endCustomer }}\n*Value:* \\${{ Number($json.dealValue).toLocaleString() }}\n*Product:* {{ $json.productCategory }}\n*Win Rate:* {{ Math.round($json.winRateScore) }}% | *Expertise:* {{ Math.round($json.expertiseScore) }}/100\n*Recommendation:* Auto-approve with {{ $json.recommendedDiscount }}\n*ID:* {{ $json.registrationId }}",
        "otherOptions": {
          "sendAsUser": false
        },
        "credential": {
          "id": "YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack"
        }
      }
    },
    {
      "id": "email-high-confidence",
