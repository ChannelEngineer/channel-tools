    {
      "id": "summary-processing",
      "name": "Generate Summary Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 700],
      "parameters": {
        "language": "python",
        "code": "import json\nfrom collections import Counter, defaultdict\n\nentries = []\nfor item in items:\n    entries.append(item['json'])\n\nif not entries:\n    return [{'json': {'summary_text': 'No velocity data recorded in the past 7 days.'}}]\n\n# Aggregate metrics\ntotal = len(entries)\ntiers_count = Counter(e.get('tier', 'unknown') for e in entries)\nstatus_count = Counter(e.get('velocity_status', 'unknown') for e in entries)\ncm_count = Counter(e.get('channel_manager', 'Unassigned') for e in entries)\nalert_count = Counter(e.get('alert_level', 'info') for e in entries)\nmilestone_count = Counter(e.get('milestone', 'unknown') for e in entries)\n\navg_score = sum(e.get('velocity_score', 0) for e in entries) / max(total, 1)\n\n# Top partner by velocity\nentries_sorted = sorted(entries, key=lambda e: e.get('velocity_score', 0), reverse=True)\ntop_partner = entries_sorted[0].get('partner_name', 'N/A') if entries_sorted else 'N/A'\ntop_score = entries_sorted[0].get('velocity_score', 0) if entries_sorted else 0\n\n# Partner needing most attention\nentries_sorted_asc = sorted(entries, key=lambda e: e.get('velocity_score', 0))\nworst_partner = entries_sorted_asc[0].get('partner_name', 'N/A') if entries_sorted_asc else 'N/A'\nworst_score = entries_sorted_asc[0].get('velocity_score', 0) if entries_sorted_asc else 0\n\nsummary = f'''*CHRONOS Weekly Velocity Summary* :bar_chart:\n\n*Period:* Past 7 days\n*Total Milestones Logged:* {total}\n*Average Velocity Score:* {avg_score:.0f}/100\n\n*By Status:*\n'''\n\nif status_count.get('ahead', 0) > 0:\n    summary += f'  :rocket: Ahead: {status_count[\"ahead\"]}\\n'\nif status_count.get('on_track', 0) > 0:\n    summary += f'  :white_check_mark: On Track: {status_count[\"on_track\"]}\\n'\nif status_count.get('at_risk', 0) > 0:\n    summary += f'  :warning: At Risk: {status_count[\"at_risk\"]}\\n'\nif status_count.get('critical', 0) > 0:\n    summary += f'  :rotating_light: Critical: {status_count[\"critical\"]}\\n'\n\nsummary += f'''\n*Top Performer:* {top_partner} ({top_score}/100)\n*Needs Attention:* {worst_partner} ({worst_score}/100)\n\n*By Alert Level:*\n'''\nfor level, count in sorted(alert_count.items()):\n    summary += f'  {level}: {count}\\n'\n\nsummary += f'\\n*By Milestone:*\\n'\nfor ms, count in sorted(milestone_count.items()):\n    summary += f'  {ms}: {count}\\n'\n\nreturn [{'json': {'summary_text': summary, 'total': total, 'avg_score': round(avg_score, 1), 'top_partner': top_partner, 'worst_partner': worst_partner}}]\n"
      }
    },
