    {
      "id": "calculate-velocity",
      "name": "Calculate Velocity Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300],
      "parameters": {
        "language": "python",
        "code": "import json\nfrom datetime import datetime, date\n\nitem = items[0]['json']\nmilestone = item.get('milestone', '')\nonboarding_days = item.get('onboarding_date_days_ago', 0)\nmilestone_date_str = item.get('milestone_date', '')\nbenchmarks = {\n    'onboarding_complete': item.get('benchmark_onboarding_complete_days', 14),\n    'first_training': item.get('benchmark_first_training_days', 21),\n    'first_certification': item.get('benchmark_first_certification_days', 45),\n    'first_deal_registered': item.get('benchmark_first_deal_registered_days', 60),\n    'first_deal_won': item.get('benchmark_first_deal_won_days', 120),\n    'first_mdf_claim': item.get('benchmark_first_mdf_claim_days', 75),\n    'first_qbr_attended': item.get('benchmark_first_qbr_days', 150),\n}\n\n# Calculate days since onboarding to this milestone\nif milestone_date_str:\n    try:\n        milestone_date = datetime.fromisoformat(milestone_date_str.replace('Z', '+00:00'))\n        onboarding_date = milestone_date.replace(day=milestone_date.day - onboarding_days) if onboarding_days > 0 else milestone_date\n        actual_days = onboarding_days if onboarding_days > 0 else 0\n    except:\n        actual_days = onboarding_days\nelse:\n    actual_days = onboarding_days\n\n# Get benchmark for this milestone\nbenchmark_days = benchmarks.get(milestone, 60)\n\n# Calculate velocity ratio (higher = faster)\nvelocity_ratio = benchmark_days / max(actual_days, 1) if actual_days > 0 else None\n\n# Velocity score: 100 = exactly on benchmark, >100 = ahead, <100 = behind\nvelocity_score = round(min(velocity_ratio * 100, 300)) if velocity_ratio else 100\n\n# Days ahead or behind\nif actual_days > 0:\n    days_delta = benchmark_days - actual_days\nelse:\n    days_delta = 0\n\nitem['actual_days_to_milestone'] = actual_days\nitem['benchmark_days'] = benchmark_days\nitem['velocity_score'] = velocity_score\nitem['days_ahead'] = max(days_delta, 0)\nitem['days_behind'] = max(-days_delta, 0)\nitem['velocity_status'] = 'ahead' if days_delta > 5 else ('on_track' if days_delta >= -5 else ('at_risk' if days_delta >= -20 else 'critical'))\n\nreturn [{'json': item}]\n"
      }
    },
